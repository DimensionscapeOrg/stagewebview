<xml>

	<pragma once="true" />
	<set name="STAGEWEBVIEW_OBJ_DIR" value="${this_dir}/obj" unless="STAGEWEBVIEW_OBJ_DIR" />

	<section if="windows">
		<compiler id="MSVC">
			<objdir value="${STAGEWEBVIEW_OBJ_DIR}/msvc${MSVC_VER}${OBJEXT}${OBJCACHE}${XPOBJ}" unless="winrt" />
			<objdir value="${STAGEWEBVIEW_OBJ_DIR}/msvc${MSVC_VER}-rt${OBJEXT}${OBJCACHE}${XPOBJ}" if="winrt" />
			<objdir value="${STAGEWEBVIEW_OBJ_DIR}/msvc${MSVC_VER}-arm${OBJEXT}${OBJCACHE}${XPOBJ}" if="HXCPP_ARM64" />
		</compiler>

		<linker id="dll">
			<libdir name="${STAGEWEBVIEW_OBJ_DIR}/lib" />
		</linker>

		<linker id="exe">
			<libdir name="${STAGEWEBVIEW_OBJ_DIR}/lib" />
		</linker>

		<linker id="static_link">
			<libdir name="${STAGEWEBVIEW_OBJ_DIR}/lib" />
		</linker>

		<files id="haxe">
			<compilerflag value="-I${this_dir}/.." />
			<compilerflag value="-I${this_dir}/../lib/windows" />
			<file name="${this_dir}/../lib/WebViewBackend.cpp" />
			<file name="${this_dir}/../lib/WebViewBindings.cpp" />
			<file name="${this_dir}/../lib/WindowBackend.cpp" />
			<file name="${this_dir}/../lib/WindowBindings.cpp" />
		</files>

		<files id="__main__">
			<compilerflag value="-I${this_dir}/.." />
			<compilerflag value="-I${this_dir}/../lib/windows" />
		</files>
	</section>

	<!-- Linux: the vendored webview.h GTK backend. GTK and WebKitGTK flags come from pkg-config through
	     ExtraParamsMacro, because hxcpp build files cannot run it themselves. The library's own group keeps
	     those flags, and hxcpp's precompiled header, away from the generated Haxe sources; the haxe tag
	     gives it the same hxcpp ABI defines. -->
	<section if="linux" unless="android || windows">
		<files id="stagewebview-native" tags="haxe,static">
			<compilerflag value="-I${this_dir}/.." />
			<compilerflag value="-I${HXCPP}/include" />
			<file name="${this_dir}/../lib/WebViewBackendPlatform.cpp" />
			<file name="${this_dir}/../lib/gtk/GtkWebView.cpp" />
			<file name="${this_dir}/../lib/gtk/GtkHostWindow.cpp" />
			<file name="${this_dir}/../lib/WebViewBindings.cpp" />
			<file name="${this_dir}/../lib/WindowBindings.cpp" />
		</files>

		<files id="haxe">
			<compilerflag value="-I${this_dir}/.." />
		</files>

		<files id="__main__">
			<compilerflag value="-I${this_dir}/.." />
		</files>
	</section>

	<!-- macOS and iOS: one WKWebView engine in Objective-C++ (ARC) for both. -->
	<section if="macos || iphone">
		<files id="stagewebview-native" tags="haxe,static">
			<compilerflag value="-I${this_dir}/.." />
			<compilerflag value="-I${HXCPP}/include" />
			<file name="${this_dir}/../lib/WebViewBackendPlatform.cpp" />
			<file name="${this_dir}/../lib/WebViewBindings.cpp" />
			<file name="${this_dir}/../lib/WindowBindings.cpp" />
		</files>

		<files id="stagewebview-apple" tags="haxe,static">
			<compilerflag value="-I${this_dir}/.." />
			<compilerflag value="-fobjc-arc" />
			<compilerflag value="-std=c++11" />
			<file name="${this_dir}/../lib/apple/AppleWebView.mm" />
			<file name="${this_dir}/../lib/apple/AppleHostWindow.mm" />
		</files>

		<files id="haxe">
			<compilerflag value="-I${this_dir}/.." />
		</files>

		<files id="__main__">
			<compilerflag value="-I${this_dir}/.." />
		</files>
	</section>

	<target id="haxe">
		<section if="linux" unless="android || windows">
			<files id="stagewebview-native" />
		</section>

		<section if="macos || iphone">
			<files id="stagewebview-native" />
			<files id="stagewebview-apple" />
		</section>

		<section if="macos">
			<vflag name="-framework" value="WebKit" />
			<vflag name="-framework" value="Cocoa" />
		</section>
	</target>

</xml>
