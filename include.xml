<?xml version="1.0" encoding="utf-8"?>
<extension>

	<haxeflag name="--macro" value="stagewebview._internal.ExtraParamsMacro.include()" />

	<assets path="ndll/Windows64/stagewebview.hdll" rename="stagewebview.hdll" unless="HXCPP_M32" if="hl windows" />

	<!-- Android: the Java host and the PrintDocumentAdapter helper. -->
	<java path="android/src" if="android" />

	<!-- macOS and iOS: the WKWebView engine. -->
	<dependency name="WebKit.framework" if="ios || mac" />

</extension>
